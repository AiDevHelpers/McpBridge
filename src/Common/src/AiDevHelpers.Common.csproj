<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiDevHelpers.Common</RootNamespace>
    <AssemblyName>AiDevHelpers.Common</AssemblyName>
    <PackageId>AiDevHelpers.Common</PackageId>
    <IsPackable>true</IsPackable>
    <Authors>AiDevHelpers</Authors>
    <RepositoryUrl>https://github.com/AiDevHelpers/McpBridge</RepositoryUrl>
    <Description>AiDevHelpers Common: shared process runner and contracts used by the helper packages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\mcp-tools.md">
      <LogicalName>AiDevHelpers.Common.Resources.mcp-tools.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\mcp-self-test.md">
      <LogicalName>AiDevHelpers.Common.Resources.mcp-self-test.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
