<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>AiDevHelpers.Core</PackageId>
    <IsPackable>true</IsPackable>
    <Authors>AiDevHelpers</Authors>
    <RepositoryUrl>https://github.com/AiDevHelpers/McpBridge</RepositoryUrl>
    <Description>AiDevHelpers core library: shared configuration paths and settings.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.10.94" />
  </ItemGroup>
</Project>
