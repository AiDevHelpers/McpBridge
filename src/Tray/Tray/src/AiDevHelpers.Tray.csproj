<Project Sdk="Microsoft.NET.Sdk">

  <!-- Per-user tray app: status icon, pages, MVVM over IObservable. Plain WPF with the Fluent theme.
       See docs/plans/2026-11-26-tray-service.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiDevHelpers.Tray</RootNamespace>
    <AssemblyName>AiDevHelpers.Tray</AssemblyName>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\MCP\Core\src\AiDevHelpers.MCP.Core.csproj" />
    <ProjectReference Include="..\..\..\Bridge\src\AiDevHelpers.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.9" />
  </ItemGroup>

</Project>
