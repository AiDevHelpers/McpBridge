<Window x:Class="AiDevHelpers.Tray.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True">
  <StackPanel Margin="16">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap"/>
    <TextBlock x:Name="ToolText" FontWeight="Bold" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="DetailText" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="DenyButton" Width="100" Margin="0,0,8,0" IsCancel="True"/>
      <Button x:Name="AllowButton" Width="110"/>
    </StackPanel>
  </StackPanel>
</Window>

