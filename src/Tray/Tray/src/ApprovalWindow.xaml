<Window x:Class="AiDevHelpers.Tray.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiDevHelpers: allow this call?" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True">
  <StackPanel Margin="16">
    <TextBlock Text="An AI client wants to run a dangerous tool:" TextWrapping="Wrap"/>
    <TextBlock x:Name="ToolText" FontWeight="Bold" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
               Text="Only allow it if you started this request. The arguments are not shown; the request is refused if you do not answer in time."/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="DenyButton" Content="Deny" Width="100" Margin="0,0,8,0" IsCancel="True"/>
      <Button x:Name="AllowButton" Content="Allow once" Width="110"/>
    </StackPanel>
  </StackPanel>
</Window>

