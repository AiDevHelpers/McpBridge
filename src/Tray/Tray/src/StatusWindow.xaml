<Window x:Class="AiDevHelpers.Tray.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
  <TabControl x:Name="Tabs" Margin="8">
    <TabItem x:Name="StatusTab">
      <StackPanel Margin="8">
        <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Margin="0,12,0,0" Text="{Binding EndpointText}"/>
        <TextBlock Margin="0,4,0,0" Text="{Binding SessionsText}"/>
        <TextBlock Margin="0,4,0,0" Text="{Binding IconText}"/>
      </StackPanel>
    </TabItem>
    <TabItem x:Name="InstancesTab">
      <Grid Margin="8">
        <DataGrid x:Name="InstancesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="240" MinWidth="560">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="IdeColumn" Binding="{Binding Ide}"/>
            <DataGridTextColumn x:Name="RepoColumn" Binding="{Binding RepoText}"/>
            <DataGridTextColumn x:Name="BranchColumn" Binding="{Binding BranchText}"/>
            <DataGridTextColumn x:Name="PathColumn" Binding="{Binding Path}"/>
            <DataGridTextColumn x:Name="StartedColumn" Binding="{Binding StartedText}"/>
            <DataGridTextColumn x:Name="PidColumn" Binding="{Binding Pid}"/>
            <DataGridTextColumn x:Name="UserColumn" Binding="{Binding UserText}"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </Grid>
    </TabItem>
  </TabControl>
</Window>

