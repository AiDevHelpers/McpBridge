<Window x:Class="AiDevHelpers.Tray.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiDevHelpers" Width="440" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="16">
    <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Margin="0,12,0,0" Text="{Binding Endpoint, StringFormat=MCP endpoint: {0}}"/>
    <TextBlock Margin="0,4,0,0" Text="{Binding Sessions, StringFormat=Active sessions: {0}, TargetNullValue=not reported}"/>
    <TextBlock Margin="0,4,0,0" Text="{Binding Icon, StringFormat=Tray state: {0}}"/>
  </StackPanel>
</Window>

