<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the Host service and the tray share about the HTTP MCP: the endpoint record and token files, and the
       /healthz call. No UI and no Windows APIs. See docs/plans/2026-11-26-tray-service.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiDevHelpers.Mcp.Client</RootNamespace>
    <AssemblyName>AiDevHelpers.Mcp.Client</AssemblyName>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
