<Project Sdk="Microsoft.NET.Sdk">

  <!-- Logic for the Visual Studio 2026 extension: IDE actions, bridge host, logging. No package attributes here;
       the VSIX project (AiDevHelpers.Installers.Vs2026.Installer) holds the UI and setup code only. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiDevHelpers.Installers.Vs2026.Core</RootNamespace>
    <AssemblyName>AiDevHelpers.Installers.Vs2026.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="18.12.1606" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Bridge\src\AiDevHelpers.Bridge.csproj" SetTargetFramework="TargetFramework=net48" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AiDevHelpers.Installers.Vs2026.Core.Tests" />
  </ItemGroup>

  <!-- Roslyn (phase 6). Compile-time only (ExcludeAssets runtime): the running Visual Studio loads its own Roslyn, so the
       assemblies are never copied into the VSIX. Versions match the Roslyn in Visual Studio 18 (5.12). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0-1.26573.119" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="5.12.0-1.26573.119" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
