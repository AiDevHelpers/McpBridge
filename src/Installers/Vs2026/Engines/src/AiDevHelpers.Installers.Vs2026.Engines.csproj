<Project Sdk="Microsoft.NET.Sdk">

  <!-- Solution-only tool engines shared by the Visual Studio bridge (Core, net48) and the Roslyn helper (net10.0-windows).
       No EnvDTE or Microsoft.VisualStudio types here; those stay in Core. Namespaces and the Strings resource name are kept
       from Core so the move does not change call sites. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiDevHelpers.Installers.Vs2026.Core</RootNamespace>
    <AssemblyName>AiDevHelpers.Installers.Vs2026.Engines</AssemblyName>
  </PropertyGroup>

  <!-- Roslyn: the VS bridge loads Visual Studio's own Roslyn, so net48 excludes runtime assets. The helper ships its own. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0-1.26573.119" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AiDevHelpers.Installers.Vs2026.Core" />
    <InternalsVisibleTo Include="AiDevHelpers.Installers.Vs2026.Core.Tests" />
    <InternalsVisibleTo Include="RoslynHelper" />
    <InternalsVisibleTo Include="AiDevHelpers.Helpers.RoslynHelper.Tests" />
  </ItemGroup>

</Project>
