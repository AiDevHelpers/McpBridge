<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 for the in-process Visual Studio extension (classic VSSDK); net10.0-windows for AiDevHelpers.MCP. -->
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiDevHelpers.Bridge</RootNamespace>
    <AssemblyName>AiDevHelpers.Bridge</AssemblyName>
    <PackageId>AiDevHelpers.Bridge</PackageId>
    <Version>0.1.0</Version>
    <Authors>AiDevHelpers</Authors>
    <Description>Named-pipe bridge between Visual Studio and AiDevHelpers.MCP: protocol, instance registry and client routing.</Description>
    <RepositoryUrl>https://github.com/AiDevHelpers/McpBridge</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- .NET Framework 4.8 lacks System.Text.Json and the records/required-member support the code uses. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
