<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>AiDevHelpers.Helpers.LogHelper</PackageId>
    <IsPackable>true</IsPackable>
    <Authors>AiDevHelpers</Authors>
    <RepositoryUrl>https://github.com/AiDevHelpers/McpBridge</RepositoryUrl>
    <Description>AiDevHelpers LogHelper library for the IDE bridge.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    <!-- CA1021: TryParse-style out parameters are intentional. CA1308: lowercase is the canonical form for keys and hashes here, not a display string. -->
    <NoWarn>$(NoWarn);CA1021;CA1308</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="SelfTest.md" LogicalName="AiDevHelpers.SelfTest.md" />
  </ItemGroup>
</Project>
