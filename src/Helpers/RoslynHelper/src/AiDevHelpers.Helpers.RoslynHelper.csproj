<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>RoslynHelper</AssemblyName>
    <RootNamespace>AiDevHelpers.Helpers.RoslynHelper</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Bridge\src\AiDevHelpers.Bridge.csproj" />
    <ProjectReference Include="..\..\..\Installers\Vs2026\Engines\src\AiDevHelpers.Installers.Vs2026.Engines.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- Runtime comes from the registered MSBuild SDK, not a copy in the output (Locator error MSBL001). -->
    <PackageReference Include="Microsoft.Build.Framework" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
