<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
    <add key="aidevhelpers" value="https://nuget.pkg.github.com/AiDevHelpers/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <aidevhelpers>
      <add key="Username" value="AiDevHelpers" />
      <add key="ClearTextPassword" value="%AIDEVHELPERS_NUGET_TOKEN%" />
    </aidevhelpers>
  </packageSourceCredentials>
</configuration>
