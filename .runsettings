<?xml version="1.0" encoding="utf-8"?>
<!-- Visual Studio picks this up from the solution folder. The Tpm tests need administrator rights and a TPM,
     so Test Explorer skips them. The full gate runs them elevated through scripts/gate-tpm.ps1. -->
<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>Category!=Tpm</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
